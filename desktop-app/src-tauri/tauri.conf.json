{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FastVM",
  "version": "0.1.0",
  "identifier": "dev.cloudcompile.fastvm",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "FastVM Marketplace",
        "width": 1200,
        "height": 800,
        "minWidth": 920,
        "minHeight": 620,
        "resizable": true,
        "backgroundColor": "#0a0e27"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "One-click streamed Linux desktops",
    "longDescription": "FastVM Marketplace launches and manages streamed Linux desktops from Linux, Windows, and macOS."
  }
}
